<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView android:text="⏰" android:textSize="30sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                <TextView android:text="Smart Alarm" android:textSize="23sp" android:textStyle="bold"
                    android:textColor="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="STRICT MODE • SNOOZE DISABLED" android:textSize="10sp"
                    android:textColor="@color/red" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <Button android:id="@+id/testAlarm" android:text="TEST ALARM" android:textSize="11sp"
                android:textColor="@color/bg" android:background="@drawable/button_cyan"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView android:id="@+id/clockText" android:text="12:00:00 AM" android:textSize="42sp"
            android:textStyle="bold" android:textColor="@color/cyan" android:gravity="center"
            android:layout_marginTop="22dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/dateText" android:text="Sunday, August 16, 2026" android:textSize="14sp"
            android:textColor="@color/muted" android:gravity="center"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_panel" android:layout_marginTop="22dp">
            <TextView android:text="NEW ALARM" android:textColor="@color/cyan" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TimePicker android:id="@+id/timePicker" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:timePickerMode="spinner"/>

            <TextView android:text="Alarm sound • Alarm stream" android:textColor="@color/white"
                android:textStyle="bold" android:layout_marginTop="8dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Spinner android:id="@+id/soundSpinner" android:layout_width="match_parent" android:layout_height="48dp"/>
            <Button android:id="@+id/customSound" android:text="📂 Choose custom MP3 / WAV"
                android:layout_width="match_parent" android:layout_height="48dp"/>
            <TextView android:id="@+id/customSoundName" android:text="Built-in alarm sound"
                android:textColor="@color/muted" android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <TextView android:text="Verification tasks" android:textColor="@color/white" android:textStyle="bold"
                android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/mathToggle" android:text="Task 1 • Mental Math (3 correct)"
                android:textColor="@color/white" android:checked="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/cameraToggle" android:text="Task 2 • Camera Motion + Head Turn"
                android:textColor="@color/white" android:checked="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/simonToggle" android:text="Task 3 • Simon Color Memory"
                android:textColor="@color/white" android:checked="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <Button android:id="@+id/addAlarm" android:text="＋ SAVE ALARM"
                android:textColor="@color/bg" android:background="@drawable/button_cyan"
                android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="52dp"/>
        </LinearLayout>

        <TextView android:text="SCHEDULED ALARMS" android:textColor="@color/cyan" android:textStyle="bold"
            android:layout_marginTop="22dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <LinearLayout android:id="@+id/alarmList" android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
