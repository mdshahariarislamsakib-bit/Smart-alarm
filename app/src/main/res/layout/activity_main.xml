<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/mainContentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:src="@drawable/ic_alarm"
                android:layout_width="38dp"
                android:layout_height="38dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:text="Smart Alarm"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="STRICT MODE • SNOOZE DISABLED"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="@color/red"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <Button
                android:id="@+id/testAlarm"
                android:text="⚡ TEST"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/bg"
                android:background="@drawable/button_cyan"
                android:layout_width="wrap_content"
                android:layout_height="40dp" />
        </LinearLayout>

        <!-- Digital Clock HUD Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_panel"
            android:layout_marginTop="18dp"
            android:padding="20dp">

            <TextView
                android:id="@+id/clockText"
                android:text="12:00:00 AM"
                android:textSize="38sp"
                android:textStyle="bold"
                android:textColor="@color/cyan"
                android:letterSpacing="0.04"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/dateText"
                android:text="Sunday, August 16, 2026"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Create Alarm Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:layout_marginTop="16dp"
            android:padding="18dp">

            <TextView
                android:text="SET NEW ALARM"
                android:textColor="@color/cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TimePicker
                android:id="@+id/timePicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:timePickerMode="spinner"
                android:layout_marginTop="4dp" />

            <TextView
                android:text="Sound Stream • Alarm Channel"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Spinner
                android:id="@+id/soundSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/customSound"
                android:text="📂 Choose Custom MP3 / WAV"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_panel"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="46dp" />

            <TextView
                android:id="@+id/customSoundName"
                android:text="Built-in alarm sound"
                android:textSize="12sp"
                android:textColor="@color/muted"
                android:layout_marginTop="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Required Verification Tasks"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <CheckBox
                android:id="@+id/mathToggle"
                android:text="Task 1 • Mental Math (3 Problems)"
                android:textColor="@color/white"
                android:buttonTint="@color/cyan"
                android:checked="true"
                android:layout_marginTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <CheckBox
                android:id="@+id/cameraToggle"
                android:text="Task 2 • Realtime Face &amp; Eye Detection"
                android:textColor="@color/white"
                android:buttonTint="@color/cyan"
                android:checked="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <CheckBox
                android:id="@+id/simonToggle"
                android:text="Task 3 • Simon Says Musical Memory"
                android:textColor="@color/white"
                android:buttonTint="@color/cyan"
                android:checked="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/addAlarm"
                android:text="＋ SAVE &amp; SCHEDULE ALARM"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/bg"
                android:background="@drawable/button_cyan"
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="52dp" />
        </LinearLayout>

        <!-- Scheduled Alarms List -->
        <TextView
            android:text="ACTIVE ALARMS"
            android:textColor="@color/cyan"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginTop="22dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/alarmList"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="30dp" />
    </LinearLayout>
</ScrollView>
