<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Glowing pulsing logo container -->
        <FrameLayout
            android:id="@+id/logoContainer"
            android:layout_width="110dp"
            android:layout_height="110dp">

            <View
                android:id="@+id/glowRing"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/ic_alarm"
                android:alpha="0.3" />

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_alarm" />
        </FrameLayout>

        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="SMART ALARM"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/splashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="STRICT WAKE-UP GUARANTEED"
            android:textColor="@color/cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.18" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:text="v3.0 • Advanced Edition"
        android:textColor="@color/muted_dark"
        android:textSize="12sp" />
</FrameLayout>
