<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg">

    <TextView
        android:text="🎨 SIMON MEMORY"
        android:textColor="@color/cyan"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/level"
        android:text="Level 1 • Watch Sequence"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/simonStatus"
        android:text="Watch the lights &amp; sound…"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:layout_marginTop="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <GridLayout
        android:rowCount="2"
        android:columnCount="2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:useDefaultMargins="true">

        <Button
            android:id="@+id/red"
            android:text="RED"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:tag="0"
            android:background="@drawable/bg_simon_red"
            android:layout_width="145dp"
            android:layout_height="125dp"
            android:layout_margin="8dp" />

        <Button
            android:id="@+id/blue"
            android:text="BLUE"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:tag="1"
            android:background="@drawable/bg_simon_blue"
            android:layout_width="145dp"
            android:layout_height="125dp"
            android:layout_margin="8dp" />

        <Button
            android:id="@+id/yellow"
            android:text="YELLOW"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:tag="2"
            android:background="@drawable/bg_simon_yellow"
            android:layout_width="145dp"
            android:layout_height="125dp"
            android:layout_margin="8dp" />

        <Button
            android:id="@+id/green"
            android:text="GREEN"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:tag="3"
            android:background="@drawable/bg_simon_green"
            android:layout_width="145dp"
            android:layout_height="125dp"
            android:layout_margin="8dp" />
    </GridLayout>
</LinearLayout>
